# Copy to ~/.karagoz-anim/.env (outside this repo; override the path with KARAGOZ_ENV) and fill in.
# Never put real keys inside the repository: coding agents read it. `karagoz doctor` refuses an env file in the repo.
META_API_KEY=
ELEVENLABS_API_KEY=
# TYPESAFE_API_KEY=  # optional, only when Jev is on (jev: on in studio.yaml)
